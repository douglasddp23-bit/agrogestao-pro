# ============================================================
# CONFIGURAÇÃO FIREBASE — OBRIGATÓRIO PARA PRODUÇÃO
# Obter em: https://console.firebase.google.com
# → Configurações do projeto → Seus apps → SDK de configuração
# ============================================================
VITE_FIREBASE_API_KEY="sua_api_key_aqui"
VITE_FIREBASE_AUTH_DOMAIN="seu_projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu_projeto_id"
VITE_FIREBASE_STORAGE_BUCKET="seu_projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000:web:000000000"

# ============================================================
# ADMIN PRINCIPAL — e-mail que recebe permissão máxima
# ============================================================
VITE_ADMIN_EMAIL="seu_email_admin@dominio.com.br"
ADMIN_EMAIL="seu_email_admin@dominio.com.br"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Enterprise Authentication & SMTP Mailer Configuration
SMTP_USER="suporte.agrogestao@example.com"
SMTP_PASS="sua_senha_smtp_aqui"

# Evolution API (WhatsApp Integration)
# EVOLUTION_API_URL="https://instancia.evolution-api.io"
# EVOLUTION_API_KEY="SUA_CHAVE_COMPLETA_EVOLUTION"
# EVOLUTION_INSTANCE="main"

# Firebase Admin SDK (Server Override)
# FIREBASE_PROJECT_ID=""
# FIREBASE_DATABASE_ID=""
# FIREBASE_API_KEY=""


