rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =====================================================================
    // REGRAS DE SEGURANÇA — AgroGestão Pro
    // Princípios:
    //  • Tudo bloqueado por padrão; cada coleção libera só o necessário.
    //  • O cargo vem SÓ do token (custom claim "role"), que só o servidor grava
    //    para contas criadas por um administrador. Não há mais e-mail "mágico"
    //    de administrador (admin@agrogestao.com.br não existia e qualquer um
    //    poderia criar essa conta e virar admin).
    //  • "Dono" de um registro é sempre conferido no documento EXISTENTE
    //    (existing()), nunca no que o usuário está enviando — antes bastava
    //    escrever createdBy = meu uid para editar o registro de outra pessoa.
    // =====================================================================

    // 0. Bloqueio global
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function getRole() {
      return (request.auth != null && request.auth.token != null && 'role' in request.auth.token)
        ? request.auth.token.role
        : 'none';
    }

    // Bloqueio de conta é feito no Firebase Auth (conta desativada + tokens
    // revogados pelo servidor). Mantido como função para documentação.
    function isNotBlocked() {
      return true;
    }

    function isPrimaryAdmin() {
      return request.auth != null && request.auth.token != null && request.auth.token.get('isPrimaryAdmin', false) == true;
    }

    function isAdmin()      { return isSignedIn() && (getRole() == 'admin' || isPrimaryAdmin()); }
    function isHR()         { return isSignedIn() && (getRole() in ['admin', 'hr'] || isPrimaryAdmin()); }
    function isManager()    { return isSignedIn() && (getRole() in ['admin', 'manager'] || isPrimaryAdmin()); }
    function isManagement() { return isSignedIn() && (getRole() in ['admin', 'hr', 'manager'] || isPrimaryAdmin()); }
    // Qualquer colaborador cadastrado por um administrador (tem cargo no token)
    function isStaff()      { return isSignedIn() && (getRole() in ['admin', 'consultant', 'staff', 'hr', 'manager'] || isPrimaryAdmin()); }

    function isOwnerOf(field) { return isSignedIn() && existing().get(field, '') == request.auth.uid; }
    function keepsField(field) { return incoming().get(field, '') == existing().get(field, ''); }
    function strMax(v, max) { return v is string && v.size() <= max; }

    // --- Credenciais (hash de senha): só o servidor (Admin SDK) ---
    match /user_credentials/{userId} {
      allow read, write: if false;
    }

    // --- Usuários (perfil público: nome, cargo, setor) ---
    match /users/{userId} {
      // Antes: qualquer conta logada (até criada por fora) lia a equipe inteira.
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      // Criação: Admin qualquer cargo; RH só Consultor/RH; o próprio usuário só
      // com o cargo que o servidor já gravou no token (primeiro acesso).
      // Antes, qualquer conta nova criava a própria ficha como "consultor".
      allow create: if isSignedIn() && isValidId(userId) && strMax(incoming().get('displayName', ''), 120) && (
        isAdmin() ||
        (isHR() && request.auth.uid != userId && incoming().get('role', 'consultant') in ['consultant', 'hr']) ||
        (request.auth.uid == userId && getRole() in ['admin', 'consultant', 'staff', 'hr', 'manager'] && incoming().get('role', '') == getRole())
      );
      allow update: if isSignedIn() && strMax(incoming().get('displayName', ''), 120) && (
        isAdmin() ||
        (isManagement() && request.auth.uid != userId
          && !incoming().diff(existing()).affectedKeys().hasAny(['blocked', 'uid', 'isPrimaryAdmin'])
          && (!incoming().diff(existing()).affectedKeys().hasAny(['role'])
              || (isHR() && incoming().get('role', '') in ['consultant', 'hr'] && existing().get('role', '') in ['consultant', 'hr', 'staff']))) ||
        (request.auth.uid == userId
          && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'blocked', 'uid', 'email', 'registrationNumber', 'isPrimaryAdmin', 'createdBy']))
      );
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // --- Ficha confidencial do colaborador (CPF, salário, dados bancários) ---
    match /employee_records/{userId} {
      allow read: if isHR() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if isHR() && isValidId(userId);
      allow delete: if isAdmin();
    }

    // --- Delegações temporárias (cobertura de férias/ausência) ---
    match /delegations/{delegationId} {
      allow read: if isHR() || (isSignedIn() && (existing().delegateUserId == request.auth.uid || existing().absentUserId == request.auth.uid));
      // RH só delega cargos de Consultor/RH; cargos de Gerente/Admin só o Administrador.
      allow create: if isValidId(delegationId) && incoming().active == true
        && incoming().createdBy == request.auth.uid
        && incoming().delegateUserId is string && incoming().absentUserId is string
        && incoming().delegateUserId != incoming().absentUserId
        && (isAdmin() || (isHR() && incoming().absentUserRole in ['consultant', 'hr']));
      allow update: if isHR() && isValidId(delegationId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'revokedAt', 'revokedBy', 'revokeReason', 'updatedAt'])
        && incoming().active == false;
      allow delete: if isAdmin();
    }

    // --- Registro de login (gravado pelo servidor) ---
    match /login_logs/{logId} {
      allow list: if isAdmin();
      allow get: if isAdmin() && isValidId(logId);
    }

    // --- Clientes (produtores) ---
    match /clients/{clientId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(clientId);
      allow create: if isStaff() && isValidId(clientId) && isValidClient(incoming()) && incoming().createdBy == request.auth.uid;
      allow update: if isManager() && isValidId(clientId) && isValidClient(incoming()) && keepsField('createdBy');
      allow delete: if isAdmin() && isValidId(clientId);
    }

    function isValidClient(data) {
      return data.keys().hasAll(['name', 'cpf', 'clientType'])
             && data.name is string && data.name.size() > 0 && data.name.size() < 200
             && data.cpf is string && data.cpf.size() <= 20
             && strMax(data.get('phone', ''), 30)
             && strMax(data.get('ownerEmail', ''), 200)
             && strMax(data.get('notes', ''), 5000);
    }

    // --- Análises técnicas / serviços ---
    match /analyses/{analysisId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(analysisId);
      allow create: if isStaff() && isValidId(analysisId) && isValidAnalysis(incoming());
      // Gestão edita qualquer uma; técnico edita a que já é dele (ou assume uma sem responsável).
      allow update: if isStaff() && isValidId(analysisId) && isValidAnalysis(incoming()) && (
        isManagement() ||
        (existing().get('assignedTo', '') == request.auth.uid && keepsField('assignedTo')) ||
        (existing().get('assignedTo', '') == '' && incoming().get('assignedTo', '') == request.auth.uid) ||
        (existing().get('createdBy', '') == request.auth.uid && keepsField('createdBy'))
      );
      allow delete: if isAdmin() && isValidId(analysisId);
    }

    function isValidAnalysis(data) {
      return data.keys().hasAll(['clientId', 'type', 'status'])
             && data.type in ['soil', 'water', 'fertility', 'foliar', 'topography', 'irrigation', 'documentation', 'credit', 'environmental_xray']
             && data.status is string && data.status.size() <= 40;
    }

    // --- E-mail interno ---
    match /messages/{messageId} {
      // Cada um só lê o que enviou/recebeu (antes qualquer funcionário listava a caixa de todos).
      allow list: if isStaff() && (existing().recipientId == request.auth.uid || existing().senderId == request.auth.uid || isAdmin());
      allow get: if isStaff() && (existing().recipientId == request.auth.uid || existing().senderId == request.auth.uid || isAdmin());
      allow create: if isStaff() && isValidId(messageId) && incoming().senderId == request.auth.uid
        && strMax(incoming().get('subject', ''), 300) && strMax(incoming().get('content', ''), 50000);
      allow update: if isStaff() && isValidId(messageId) && (
        (existing().get('isDraft', false) == true && existing().senderId == request.auth.uid && incoming().senderId == request.auth.uid) ||
        ((existing().recipientId == request.auth.uid || existing().senderId == request.auth.uid) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'reactions', 'trashBy', 'starredBy']))
      );
      allow delete: if isStaff() && isValidId(messageId) && (existing().senderId == request.auth.uid || existing().recipientId == request.auth.uid);
    }

    // --- Modelos de e-mail ---
    match /email_templates/{templateId} {
      // Antes: legível por QUALQUER pessoa, mesmo sem login.
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(templateId);
      allow create: if isStaff() && isValidId(templateId) && isValidTemplate(incoming());
      allow update: if isStaff() && isValidId(templateId) && existing().createdBy == request.auth.uid && isValidTemplate(incoming());
      allow delete: if (isAdmin() || isOwnerOf('createdBy')) && isValidId(templateId);
    }

    function isValidTemplate(data) {
      return data.keys().hasAll(['title', 'subject', 'content', 'createdBy'])
             && data.title is string && data.title.size() > 0 && data.title.size() <= 200
             && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 300
             && data.content is string && data.content.size() > 0 && data.content.size() <= 20000
             && data.createdBy == request.auth.uid;
    }

    // --- Ponto eletrônico (registros imutáveis) ---
    match /attendance/{logId} {
      allow list: if isStaff() && (existing().userId == request.auth.uid || isHR());
      allow get: if isStaff() && (existing().userId == request.auth.uid || isHR());
      allow create: if isStaff() && isValidId(logId) && incoming().userId == request.auth.uid
        && incoming().type in ['in', 'out'] && incoming().timestamp is string;
    }

    // --- Lembretes pessoais ---
    match /personal_reminders/{reminderId} {
      allow read, delete: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isStaff() && isValidId(reminderId) && incoming().userId == request.auth.uid && strMax(incoming().get('text', ''), 500);
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && strMax(incoming().get('text', ''), 500);
    }

    // --- Arquivos (dossiê, laudos, fotos) guardados no Firestore — ver src/lib/fileStore.ts ---
    match /file_blobs/{fileId} {
      allow get: if isStaff() && isValidId(fileId);
      allow create: if isStaff() && isValidId(fileId)
        && incoming().createdBy == request.auth.uid
        && incoming().size is int && incoming().size <= 2097152
        && incoming().chunks is int && incoming().chunks >= 1 && incoming().chunks <= 4;
      // Antes qualquer funcionário apagava qualquer arquivo.
      allow delete: if isValidId(fileId) && (isManagement() || isOwnerOf('createdBy'));

      match /chunks/{chunkId} {
        allow read: if isStaff();
        // Só grava pedaços do PRÓPRIO arquivo (criado na mesma operação)
        allow create: if isStaff() && incoming().data is string && incoming().data.size() <= 750000
          && getAfter(/databases/$(database)/documents/file_blobs/$(fileId)).data.createdBy == request.auth.uid;
        allow delete: if isManagement()
          || (isStaff() && get(/databases/$(database)/documents/file_blobs/$(fileId)).data.createdBy == request.auth.uid);
      }
    }

    // --- Projetos de irrigação / topografia / regularização ---
    // Antes: "incoming().createdBy == meu uid" deixava editar projeto de qualquer um.
    match /irrigation_projects/{projectId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(projectId);
      allow create: if isStaff() && isValidId(projectId) && incoming().createdBy == request.auth.uid;
      allow update: if isStaff() && isValidId(projectId) && (isManagement() || isOwnerOf('createdBy')) && keepsField('createdBy');
      allow delete: if isAdmin() && isValidId(projectId);
    }

    match /topography_services/{serviceId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(serviceId);
      allow create: if isStaff() && isValidId(serviceId) && incoming().createdBy == request.auth.uid;
      allow update: if isStaff() && isValidId(serviceId) && (isManagement() || isOwnerOf('createdBy')) && keepsField('createdBy');
      allow delete: if isAdmin() && isValidId(serviceId);
    }

    match /regularization_services/{serviceId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(serviceId);
      allow create: if isStaff() && isValidId(serviceId) && incoming().createdBy == request.auth.uid;
      allow update: if isStaff() && isValidId(serviceId) && (isManagement() || isOwnerOf('createdBy')) && keepsField('createdBy');
      allow delete: if isAdmin() && isValidId(serviceId);
    }

    // --- Trilha de auditoria (imutável) ---
    match /logs/{logId} {
      // Contém valores antigos/novos de registros (CPF, valores): só gestão lê.
      allow list: if isManagement() && request.query.limit <= 300;
      allow get: if isManagement() && isValidId(logId);
      // Antes: QUALQUER pessoa, mesmo sem login, podia gravar registros falsos de auditoria.
      allow create: if isSignedIn() && isValidId(logId) && incoming().userId == request.auth.uid;
    }

    // --- Notificações ---
    match /notifications/{notificationId} {
      allow list: if isStaff() && (existing().userId == request.auth.uid || existing().userId == 'all' || isAdmin());
      allow get: if isStaff() && (existing().userId == request.auth.uid || existing().userId == 'all' || isAdmin());
      allow create: if isStaff() && isValidId(notificationId)
        && strMax(incoming().get('title', ''), 200) && strMax(incoming().get('message', ''), 2000);
      allow update: if isSignedIn() && isValidId(notificationId) && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isValidId(notificationId) && (isOwnerOf('userId') || isAdmin());
    }

    // --- Férias ---
    match /vacations/{vacationId} {
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isManagement());
      allow get: if isSignedIn() && isValidId(vacationId) && (existing().userId == request.auth.uid || isManagement());
      allow create: if isStaff() && isValidId(vacationId) && incoming().userId == request.auth.uid
        && incoming().status == 'pending' && strMax(incoming().get('reason', ''), 1000);
      allow update: if isManagement() && isValidId(vacationId) && request.auth.uid != existing().userId;
      allow delete: if isAdmin() || (isSignedIn() && isValidId(vacationId) && existing().userId == request.auth.uid && existing().status == 'pending');
    }

    // --- Licenças / afastamentos ---
    match /leaves/{leaveId} {
      allow list: if isSignedIn() && (existing().userId == request.auth.uid || isManagement());
      allow get: if isSignedIn() && isValidId(leaveId) && (existing().userId == request.auth.uid || isManagement());
      allow create: if isStaff() && isValidId(leaveId) && incoming().userId == request.auth.uid
        && incoming().status == 'pending' && strMax(incoming().get('reason', ''), 1000);
      allow update: if isManagement() && isValidId(leaveId) && request.auth.uid != existing().userId;
      allow delete: if isManagement() && isValidId(leaveId);
    }

    // --- Folha de pagamento (salário: dado sensível) ---
    match /payrolls/{payrollId} {
      allow list: if isHR() || (isSignedIn() && existing().employeeId == request.auth.uid);
      allow get: if isValidId(payrollId) && (isHR() || (isSignedIn() && existing().employeeId == request.auth.uid));
      allow create, update: if isHR() && isValidId(payrollId);
      allow delete: if isHR() && isValidId(payrollId);
    }

    // --- Reembolso de despesas ---
    match /expense_reports/{expenseId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(expenseId);
      allow create: if isStaff() && isValidId(expenseId) && incoming().createdBy == request.auth.uid
        && incoming().status == 'pending_approval' && incoming().value is number && incoming().value > 0;
      // Antes o próprio solicitante podia marcar a SUA despesa como "aprovada".
      allow update: if isStaff() && isValidId(expenseId) && (
        isManagement() ||
        (existing().createdBy == request.auth.uid && existing().status == 'pending_approval'
          && !incoming().diff(existing()).affectedKeys().hasAny(['status', 'approvedBy', 'approvedAt', 'approvalNotes', 'createdBy']))
      );
      allow delete: if isManagement() && isValidId(expenseId);
    }

    // --- Modelos de contrato ---
    match /contract_templates/{templateId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(templateId);
      allow create, update: if isManagement() && isValidId(templateId);
      allow delete: if isAdmin() && isValidId(templateId);
    }

    // --- Avaliações de imóveis rurais ---
    match /rural_valuations/{valuationId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(valuationId);
      allow create: if isStaff() && isValidId(valuationId) && incoming().createdBy == request.auth.uid;
      allow update: if isStaff() && isValidId(valuationId) && (isManagement() || isOwnerOf('createdBy')) && keepsField('createdBy');
      allow delete: if isManagement() && isValidId(valuationId);
    }

    // --- Perícias judiciais ---
    match /judicial_expertises/{expertiseId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(expertiseId);
      allow create: if isStaff() && isValidId(expertiseId) && incoming().createdBy == request.auth.uid;
      allow update: if isStaff() && isValidId(expertiseId) && (isManagement() || isOwnerOf('createdBy')) && keepsField('createdBy');
      allow delete: if isManagement() && isValidId(expertiseId);
    }

    // --- Documentos do dossiê ---
    match /documents/{docId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(docId);
      allow create: if isStaff() && isValidId(docId) && isValidDoc(incoming());
      allow update: if isStaff() && isValidId(docId) && isValidDoc(incoming()) && keepsField('clientId');
      // Antes qualquer funcionário apagava qualquer documento de qualquer cliente.
      allow delete: if isManagement() && isValidId(docId);
    }

    function isValidDoc(data) {
      return data.keys().hasAll(['clientId', 'name', 'type', 'url', 'uploadedBy', 'uploadedAt'])
             && data.clientId is string && data.clientId.size() > 0
             && data.name is string && data.name.size() > 0 && data.name.size() <= 300
             && data.url is string && data.url.size() <= 3000
             // Só arquivos do próprio sistema ou endereços https — bloqueia "javascript:" (XSS ao abrir)
             // (url vazia = pasta do laudo criada pela sincronização antes de ter arquivo)
             && (data.url == '' || data.url.matches('^fsfile://[A-Za-z0-9]+$') || data.url.matches('^https://.*') || data.url.matches('^data:application/pdf;base64,.*'));
    }

    // --- Visitas de campo ---
    match /field_visits/{visitId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(visitId);
      allow create: if isStaff() && isValidId(visitId) && incoming().technicianId == request.auth.uid;
      allow update: if isStaff() && isValidId(visitId) && (isManagement() || isOwnerOf('technicianId')) && keepsField('technicianId');
      allow delete: if isManagement() && isValidId(visitId);
    }

    // --- Financeiro (só Gerente e Administrador lêem e editam) ---
    match /financials/{id} {
      // Antes qualquer consultor lia todo o faturamento da empresa; até 28/09/2026
      // o RH também lia e gravava (sem ter a tela de Financeiro).
      allow list: if isManager();
      allow get: if isManager() && isValidId(id);
      // Qualquer colaborador pode CRIAR a cobrança pendente gerada automaticamente
      // ao concluir um serviço (ex.: análise técnica) — mas não consegue lê-la.
      allow create: if isValidId(id) && incoming().value is number && incoming().value >= 0 && (
        isManager() || (
          isStaff() && incoming().createdBy == request.auth.uid
          && incoming().status == 'pending'
          && incoming().linkedServiceId is string
        )
      );
      allow update: if isManager() && isValidId(id);
      allow delete: if isAdmin() && isValidId(id);
    }

    // --- Contratos (só Gerente e Administrador; consultor/RH não vêem valores) ---
    match /contracts/{id} {
      allow list: if isManager();
      // Leitura pública por ID só de contrato aprovado/ativo: é o link de assinatura
      // remota (/assinar/ID). O ID é aleatório e longo (não dá para adivinhar).
      allow get: if isValidId(id) && (isManager() || existing().status in ['approved', 'active', 'ativo', 'completed', 'concluido']);
      allow create: if isManager() && isValidId(id);
      allow update: if isValidId(id) && (isManager() || (
        existing().status == 'approved' &&
        incoming().status == 'active' &&
        incoming().signatureBase64 is string && incoming().signatureBase64.size() <= 500000 &&
        incoming().signedByName is string && incoming().signedByName.size() <= 200 &&
        incoming().signedAt is string &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'signatureBase64', 'signedByName', 'signedAt', 'updatedAt'])
      ));
      // Antes qualquer consultor (e depois o RH) podia excluir contratos.
      allow delete: if isManager() && isValidId(id);
    }

    // --- Pragas e doenças ---
    match /pest_disease/{id} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(id);
      allow create: if isStaff() && isValidId(id) && incoming().reportedById == request.auth.uid;
      allow update: if isStaff() && isValidId(id) && (isManagement() || isOwnerOf('reportedById')) && keepsField('reportedById');
      allow delete: if isManagement() && isValidId(id);
    }

    // --- Estoque ---
    match /inventory_items/{id} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(id);
      allow create: if isManagement() && isValidId(id);
      // Movimentação de estoque (entrada/saída) pode ser feita por qualquer colaborador,
      // mas ele só altera a quantidade — cadastro/preço só a gestão.
      allow update: if isValidId(id) && (isManagement() ||
        (isStaff() && incoming().diff(existing()).affectedKeys().hasOnly(['currentQuantity', 'updatedAt'])));
      allow delete: if isAdmin() && isValidId(id);
    }

    match /inventory_movements/{id} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(id);
      allow create: if isStaff() && isValidId(id) && incoming().responsibleId == request.auth.uid
        && incoming().type in ['in', 'out'] && incoming().quantity is number && incoming().quantity > 0;
      allow delete: if isAdmin() && isValidId(id);
    }

    // --- Raio-X ambiental ---
    match /environmental_xray/{id} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(id);
      allow create: if isStaff() && isValidId(id);
      allow update: if isStaff() && isValidId(id);
      allow delete: if isManagement() && isValidId(id);
    }

    // --- Veículos ---
    match /vehicles/{id} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(id);
      allow create, update: if isManagement() && isValidId(id);
      allow delete: if isAdmin() && isValidId(id);
    }

    match /vehicle_trips/{id} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(id);
      allow create: if isStaff() && isValidId(id) && incoming().driverId == request.auth.uid;
      allow update: if isStaff() && isValidId(id) && (isManagement() || isOwnerOf('driverId')) && keepsField('driverId');
      allow delete: if isManagement() && isValidId(id);
    }

    // --- Agenda (eventos avulsos) ---
    match /agenda_events/{eventId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(eventId);
      allow create: if isStaff() && isValidId(eventId) && isValidAgendaEvent(incoming());
      allow update: if isStaff() && isValidId(eventId) && (isAdmin() || (isOwnerOf('createdBy') && isValidAgendaEvent(incoming())));
      allow delete: if (isAdmin() || isOwnerOf('createdBy')) && isValidId(eventId);
    }

    function isValidAgendaEvent(data) {
      return data.keys().hasAll(['title', 'type', 'date', 'createdBy'])
             && data.title is string && data.title.size() > 0 && data.title.size() <= 200
             && data.type in ['reuniao', 'visita', 'ligacao', 'entrega', 'outro']
             && data.date is string && data.date.size() > 0
             && data.createdBy == request.auth.uid;
    }

    // --- Agendamentos ---
    match /appointments/{appointmentId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(appointmentId);
      allow create: if isStaff() && isValidId(appointmentId) && isValidAppointment(incoming()) && incoming().createdBy == request.auth.uid;
      allow update: if isStaff() && isValidId(appointmentId) && (
        isManagement() ||
        (isOwnerOf('createdBy') && keepsField('createdBy') && isValidAppointment(incoming())) ||
        // o técnico designado registra check-in/check-out da própria visita
        (isOwnerOf('technicianId') && incoming().diff(existing()).affectedKeys().hasOnly(['checkInLocation', 'checkOutLocation', 'status']))
      );
      allow delete: if (isManagement() || isOwnerOf('createdBy')) && isValidId(appointmentId);
    }

    function isValidAppointment(data) {
      return data.keys().hasAll(['clientId', 'clientName', 'technicianId', 'technicianName', 'serviceType', 'date', 'time', 'status', 'createdBy', 'createdAt', 'notifiedEmail', 'notifiedWhatsapp'])
             && data.clientId is string && data.clientId.size() > 0
             && data.clientName is string && data.clientName.size() > 0 && data.clientName.size() <= 200
             && data.technicianId is string && data.technicianId.size() > 0
             && data.technicianName is string && data.technicianName.size() > 0
             && data.serviceType is string && data.serviceType.size() > 0
             && data.date is string && data.date.size() > 0
             && data.time is string && data.time.size() > 0
             && data.status in ['scheduled', 'confirmed', 'completed', 'cancelled']
             && data.createdBy is string && data.createdBy.size() > 0
             && data.createdAt is string && data.createdAt.size() > 0
             && data.notifiedEmail is bool
             && data.notifiedWhatsapp is bool;
    }

    // --- Configurações (marca/logo) ---
    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isManagement() && isValidId(settingId);
    }

    // --- Canais de conversa ---
    match /channels/{channelId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(channelId);
      allow create: if isStaff() && isValidId(channelId) && incoming().createdBy == request.auth.uid && strMax(incoming().get('name', ''), 80);
      allow update: if isStaff() && isValidId(channelId) && (isOwnerOf('createdBy') || isAdmin()) && keepsField('createdBy');
      allow delete: if isStaff() && isValidId(channelId) && (isOwnerOf('createdBy') || isAdmin());
    }

    match /channel_messages/{messageId} {
      allow list: if isStaff();
      allow get: if isStaff() && isValidId(messageId);
      allow create: if isStaff() && isValidId(messageId) && incoming().senderId == request.auth.uid && strMax(incoming().get('content', ''), 10000);
      allow update: if isStaff() && isValidId(messageId) && isOwnerOf('senderId')
        && incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'content'])
        && strMax(incoming().get('content', ''), 10000);
      allow delete: if isStaff() && isValidId(messageId) && (isOwnerOf('senderId') || isAdmin());
    }

    // "Visto por" e "digitando..." dos canais (antes sem regra = nunca funcionavam)
    match /channel_reads/{readId} {
      allow read: if isStaff();
      allow write: if isStaff() && incoming().userId == request.auth.uid && readId == incoming().channelId + '_' + request.auth.uid;
    }

    match /channel_typing/{typingId} {
      allow read: if isStaff();
      allow write: if isStaff() && incoming().userId == request.auth.uid && typingId == incoming().channelId + '_' + request.auth.uid;
    }
  }
}
